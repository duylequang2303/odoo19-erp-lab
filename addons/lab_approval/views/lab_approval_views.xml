<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_approval_request_view_list" model="ir.ui.view">
        <field name="name">lab.approval.request.list</field>
        <field name="model">lab.approval.request</field>
        <field name="arch" type="xml">
            <list string="Phiếu đề xuất mua sắm">
                <field name="name" />
                <field name="requester_id" />
                <field name="department" />
                <field name="amount" sum="Tổng" />
                <field name="date_request" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'submitted'"
                    decoration-success="state == 'approved'"
                    decoration-danger="state == 'rejected'"
                />
            </list>
        </field>
    </record>

    <record id="lab_approval_request_view_form" model="ir.ui.view">
        <field name="name">lab.approval.request.form</field>
        <field name="model">lab.approval.request</field>
        <field name="arch" type="xml">
            <form string="Phiếu đề xuất mua sắm">
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Gửi duyệt"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        string="Duyệt"
                        class="btn-primary"
                        invisible="state != 'submitted'"
                    />
                    <button
                        name="action_reject"
                        type="object"
                        string="Từ chối"
                        invisible="state != 'submitted'"
                    />
                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Trả về Nháp"
                        invisible="state not in ('submitted', 'rejected')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved,rejected"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="Tên phiếu, ví dụ: Đề xuất mua máy in phòng Kế toán"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" />
                            <field name="department" />
                            <field name="date_request" />
                        </group>
                        <group>
                            <!-- Chỉ sửa được số tiền khi phiếu còn ở trạng thái Nháp -->
                            <field name="amount" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <field
                        name="description"
                        placeholder="Mô tả chi tiết nhu cầu mua sắm, lý do, đối tượng cung cấp..."
                    />
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="lab_approval_request_action" model="ir.actions.act_window">
        <field name="name">Phiếu đề xuất mua sắm</field>
        <field name="res_model">lab.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_lab_approval_root"
        name="Phê duyệt"
        parent="lab_base.menu_lab_root"
        sequence="10"
    />
    <menuitem
        id="menu_lab_approval_request"
        name="Phiếu đề xuất"
        parent="menu_lab_approval_root"
        action="lab_approval_request_action"
        sequence="10"
    />
</odoo>
