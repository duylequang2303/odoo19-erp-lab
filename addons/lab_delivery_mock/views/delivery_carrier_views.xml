<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="carrier_lab_mock_form" model="ir.ui.view">
        <field name="name">delivery.carrier.lab_mock.form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='carrier_options']" position="inside">
                <group invisible="delivery_type != 'lab_mock'">
                    <field name="lab_api_version" />
                    <field name="lab_base_url" />
                    <field name="lab_token" password="True" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
